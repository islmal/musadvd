{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConvertX Rust",
  "version": "0.1.0",
  "identifier": "de.convertx-rust.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ConvertX Rust – DVD Authoring",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../bin/*.exe": "bin/",
      "../frontend/src/locales/*.json": "locales/",
      "../bin/dvdauthor-COPYING.txt": "bin/dvdauthor-COPYING.txt",
      "../bin/tsMuxeR-LICENSE.txt": "bin/tsMuxeR-LICENSE.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyQkU5NUEyN0E3NUY1QTcKUldTbjlYVjZvcFcrUXVTVmV2SEVwVUl0aitMNnBJQXZlN1hHb01Cd3h2aUJPZU5ISEVXaXUyK08K",
      "endpoints": ["https://github.com/islmal/convertx-rust/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
